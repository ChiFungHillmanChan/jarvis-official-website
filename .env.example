RESEND_API_KEY=re_xxx
CONTACT_EMAIL=contact@jarvis-automation.com
WAITLIST_FROM=onboarding@resend.dev
NEXT_PUBLIC_SITE_URL=https://jarvis-automation.com

# Beta 申請必須成功寫入 DynamoDB；未設定時 API 回傳 503，不會發送郵件。
WAITLIST_TABLE_NAME=
AWS_REGION=ap-southeast-1
# Vercel 使用 production 專用 OIDC role，不儲存長期 AWS access key。
AWS_ROLE_ARN=
# 本機可省略 AWS_ROLE_ARN，改用具表寫入權限的 AWS_PROFILE。
# AWS_PROFILE=jarvis-deploy
# 驗收或只用資料庫收集時設 false，完全停用兩封補充郵件。
WAITLIST_EMAILS_ENABLED=false

# 只填 Search Console HTML tag 的 content token；DNS 網域驗證毋須此變數。
GOOGLE_SITE_VERIFICATION=
